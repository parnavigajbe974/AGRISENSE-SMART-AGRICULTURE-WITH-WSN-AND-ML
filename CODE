import pandas as pd
import numpy as np
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler, LabelEncoder
from sklearn.cluster import KMeans
from sklearn.svm import SVR
from sklearn.ensemble import RandomForestRegressor
import tensorflow as tf
from tensorflow.keras.models import Sequential
from tensorflow.keras.layers import Dense, Dropout

# Load datasets
sensor_data = pd.read_csv("real_time_sensor_data.csv", encoding="ISO-8859-1")
precipitation_data = pd.read_csv("precipitation_data.csv", encoding="ISO-8859-1")
crop_data = pd.read_csv("crop_yield_prediction.csv", encoding="ISO-8859-1")

# Convert timestamps (Fix missing timestamps by filling forward)
for df in [sensor_data, precipitation_data]:
    if "Timestamp" in df.columns:
        df["Timestamp"] = pd.to_datetime(df["Timestamp"], errors="coerce")
        df["Timestamp"].fillna(method="ffill", inplace=True)

# Fix categorical encoding issues
le = LabelEncoder()
crop_data["Crop"] = le.fit_transform(crop_data["Crop"].astype(str))
precipitation_data["City"] = precipitation_data["City"].str.replace(r"\s*,\s*", ", ").str.strip()

# Handle missing values (Numeric → Mean, Categorical → Mode)
for df in [sensor_data, precipitation_data, crop_data]:
    df.fillna(df.mean(numeric_only=True), inplace=True)
    df.fillna(df.mode().iloc[0], inplace=True)

# Prepare training data
X_existing = crop_data.drop(columns=["Yield"], errors="ignore")
y_existing = crop_data["Yield"]
X_real_time = sensor_data.drop(columns=["Timestamp"], errors="ignore")

# Fix column mismatch
missing_cols = set(X_existing.columns) - set(X_real_time.columns)
extra_cols = set(X_real_time.columns) - set(X_existing.columns)
for col in missing_cols:
    X_real_time[col] = 0
X_real_time = X_real_time[X_existing.columns]

# Normalize features
scaler = StandardScaler()
X_existing_scaled = scaler.fit_transform(X_existing)
X_real_time_scaled = scaler.transform(X_real_time)

# K-Means Clustering
num_clusters = 3
kmeans = KMeans(n_clusters=num_clusters, random_state=42, n_init=10)
kmeans.fit(X_existing_scaled)
sensor_data["Cluster"] = kmeans.predict(X_real_time_scaled)

# Train-test split
X_train, X_test, y_train, y_test = train_test_split(X_existing_scaled, y_existing, test_size=0.2, random_state=42)

# Train models
svm_model = SVR()
svm_model.fit(X_train, y_train)

rf_model = RandomForestRegressor(n_estimators=100, random_state=42)
rf_model.fit(X_train, y_train)

# ANN model
ann_model = Sequential([
    Dense(64, activation="relu", input_shape=(X_train.shape[1],)),
    Dropout(0.3),
    Dense(32, activation="relu"),
    Dropout(0.3),
    Dense(1, activation="linear")
])
ann_model.compile(optimizer="adam", loss="mse")
ann_model.fit(X_train, y_train, epochs=50, batch_size=8, verbose=1, validation_data=(X_test, y_test))

# Predict crop yield for real-time sensor data
svm_yield_pred = svm_model.predict(X_real_time_scaled)
rf_yield_pred = rf_model.predict(X_real_time_scaled)
ann_yield_pred = ann_model.predict(X_real_time_scaled).flatten()

# Average prediction
avg_yield_pred = (svm_yield_pred + rf_yield_pred + ann_yield_pred) / 3
sensor_data["Predicted_Yield"] = avg_yield_pred

# Define recommendation logic
def recommend_action(cluster, predicted_yield):
    if cluster == 0:
        if predicted_yield < np.percentile(y_existing, 30):
            return "Immediate irrigation needed! Apply nitrogen fertilizer."
        else:
            return "Monitor soil moisture and apply light irrigation if needed."
    elif cluster == 1:
        if predicted_yield < np.percentile(y_existing, 50):
            return "Optimize irrigation and adjust phosphorus levels."
        else:
            return "Conditions are stable. Routine monitoring recommended."
    else:
        if predicted_yield < np.percentile(y_existing, 70):
            return "Optimize water & nutrient balance for higher yield."
        else:
            return "Crop is healthy. Continue monitoring."

# Apply recommendation logic
sensor_data["Action_Recommendation"] = [
    recommend_action(cluster, yield_pred)
    for cluster, yield_pred in zip(sensor_data["Cluster"], avg_yield_pred)
]

# Drop timestamp column before saving
sensor_data.drop(columns=["Timestamp"], errors="ignore", inplace=True)

# Save final output
sensor_data.to_csv("real_time_with_yield_recommendations.csv", index=False)
print("Final recommendations saved in 'real_time_with_yield_recommendations.csv'")
