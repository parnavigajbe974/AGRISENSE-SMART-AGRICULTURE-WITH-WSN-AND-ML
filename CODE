import networkx as nx
import pandas as pd
import numpy as np
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler
from sklearn.svm import SVR
from sklearn.ensemble import RandomForestRegressor
from sklearn.cluster import KMeans
from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score
import seaborn as sns
import matplotlib.pyplot as plt
from tensorflow.keras.models import Sequential
from tensorflow.keras.layers import Dense

# Load the dataset
df = pd.read_csv("crop_yield_prediction.csv", encoding="ISO-8859-1")


# Fill missing values
df.fillna(df.mean(numeric_only=True), inplace=True)

# Define features and target variable
features = ["Precipitation (mm day-1)", "Temperature at 2 Meters ( C )", "Relative Humidity at 2 Meters (%)", "Specific Humidity at 2 Meters (g/kg)"]
X = df[features]
y = df["Yield"]

# Standardize features
scaler = StandardScaler()
X_scaled = scaler.fit_transform(X)

# Train-Test Split
X_train, X_test, y_train, y_test = train_test_split(X_scaled, y, test_size=0.2, random_state=42)

# Train Random Forest Model
rf_model = RandomForestRegressor(n_estimators=200, random_state=42)
rf_model.fit(X_train, y_train)
df["Predicted_Yield_RF"] = rf_model.predict(X_scaled)  # Predict on full dataset

# Train SVM Model
svm_model = SVR(kernel='linear')
svm_model.fit(X_train, y_train)
df["Predicted_Yield_SVM"] = svm_model.predict(X_scaled)

# K-Means Clustering
kmeans = KMeans(n_clusters=5, random_state=42, n_init=20)
df["Cluster"] = kmeans.fit_predict(X_scaled)
cluster_medians = df.groupby("Cluster")[features + ["Yield"]].median()

# ANN Model
ann_model = Sequential()
ann_model.add(Dense(64, input_dim=X_train.shape[1], activation='relu'))
ann_model.add(Dense(128, activation='relu'))
ann_model.add(Dense(64, activation='relu'))
ann_model.add(Dense(1, activation='linear'))

# Compile the ANN model
ann_model.compile(optimizer='adam', loss='mse', metrics=['mae'])

# Train the ANN model
ann_model.fit(X_train, y_train, epochs=50, batch_size=32, validation_split=0.2, verbose=1)

# Predict using ANN
df["Predicted_Yield_ANN"] = ann_model.predict(X_scaled)

# Generate Recommendations
def generate_recommendations(row):
    cluster_id = row["Cluster"]
    cluster_median = cluster_medians.loc[cluster_id]
    recommendations = []

    # Rainfall-based recommendations
    if row["Precipitation (mm day-1)"] > cluster_median["Precipitation (mm day-1)"] * 1.1:
        recommendations.append("Reduce irrigation, excess rainfall detected.")
    elif row["Precipitation (mm day-1)"] < cluster_median["Precipitation (mm day-1)"] * 0.9:
        recommendations.append("Increase irrigation to compensate for low rainfall.")

    # Temperature-based recommendations
    if row["Temperature at 2 Meters ( C )"] > cluster_median["Temperature at 2 Meters ( C )"] + 1.5:
        recommendations.append("Implement cooling techniques, high temperature detected.")
    elif row["Temperature at 2 Meters ( C )"] < cluster_median["Temperature at 2 Meters ( C )"] - 1.5:
        recommendations.append("Consider warming techniques, possible cold stress.")

    # Humidity-based recommendations
    if row["Relative Humidity at 2 Meters (%)"] > cluster_median["Relative Humidity at 2 Meters (%)"] + 5:
        recommendations.append("Monitor for fungal growth, high humidity detected.")
    elif row["Relative Humidity at 2 Meters (%)"] < cluster_median["Relative Humidity at 2 Meters (%)"] - 5:
        recommendations.append("Increase humidity management, dry air detected.")

    if row["Specific Humidity at 2 Meters (g/kg)"] < cluster_median["Specific Humidity at 2 Meters (g/kg)"] - 0.2:
        recommendations.append("Slightly dry air detected, increase irrigation.")

    # Yield improvement suggestions
    if row["Predicted_Yield_RF"] < df["Predicted_Yield_RF"].median() * 0.9:
        recommendations.append("Optimize fertilization and pest control to increase yield.")
    elif row["Predicted_Yield_RF"] > df["Predicted_Yield_RF"].median() * 1.1:
        recommendations.append("Maintain current strategies, yield is optimal.")

    if not recommendations:
        return "Conditions are stable. Continue regular monitoring."

    return " ".join(recommendations)  # Show full recommendations
    # Ensure full text display in DataFrame output
pd.set_option("display.max_colwidth", None)  # No truncation of text in columns

df["Recommendations"] = df.apply(generate_recommendations, axis=1)

# Save final recommendations
df.to_csv("final_recommendations.csv", index=False)

