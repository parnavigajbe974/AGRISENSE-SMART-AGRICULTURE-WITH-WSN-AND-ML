CODE FOR COLLECTING DATA FROM AURDINO
import serial
import pandas as pd
import time
import re
import os

# Define Serial Port (Check your Arduino IDE for the correct port)
SERIAL_PORT = "COM5"  
BAUD_RATE = 9600  

# Initialize Serial Connection
ser = serial.Serial(SERIAL_PORT, BAUD_RATE, timeout=2)
time.sleep(2)  # Allow time for connection

# Define column headers
columns = ["Timestamp", "Temperature (C)", "Humidity (%)", "Soil_Moisture"]

# Initialize variables
temperature = None
humidity = None

try:
    while True:
        line = ser.readline().decode("utf-8").strip()
        
        if "Humidity" in line and "Temperature" in line:
            match = re.search(r"Humidity: ([\d.]+)%  Temperature: ([\d.]+)", line)
            if match:
                humidity = float(match.group(1))
                temperature = float(match.group(2))
        
        elif "Soil Moisture Analog Value" in line:
            if temperature is not None and humidity is not None:  # Ensure values exist
                soil_moisture = int(line.split(":")[1].strip())
                timestamp = time.strftime("%Y-%m-%d %H:%M")
                
                print(f"{timestamp} -> Temp: {temperature}°C, Humidity: {humidity}%, Soil Moisture: {soil_moisture}")

                # Save data immediately to CSV
                data = pd.DataFrame([[timestamp, temperature, humidity, soil_moisture]], columns=columns)
                try:
                    data.to_csv("real_time_sensor_data.csv", mode='a', header=not os.path.exists("real_time_sensor_data.csv"), index=False)
                    print("✅ Data saved to real_time_sensor_data.csv")
                except Exception as e:
                    print(f"⚠️ Error saving data: {e}")

except KeyboardInterrupt:
    print("Stopping data collection.")
    ser.close()

